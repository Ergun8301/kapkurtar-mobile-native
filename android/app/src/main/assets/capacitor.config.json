{
	"appId": "com.kapkurtar.app",
	"appName": "KapKurtar",
	"webDir": "dist",
	"android": {
		"overScrollMode": "never"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1000,
			"launchAutoHide": true
		},
		"StatusBar": {
			"overlaysWebView": true,
			"backgroundColor": "#00A690",
			"style": "LIGHT"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"SocialLogin": {
			"providers": {
				"google": true,
				"facebook": false,
				"apple": false,
				"twitter": false
			}
		}
	}
}
